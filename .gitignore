node_modules/
*.log

# Scratch.
.tmp/

# Release archives. tChirp 1.0.0 shipped a committed `tChirp.zip` that was a
# byte-for-byte copy of the source files beside it, so the moment either changed
# the repository held two versions of the resource with nothing to say which one
# a server had installed. Build output comes from a tag, never from the tree.
.build/
*.zip

# Local overrides, overlaid onto Config at server start by tlib.secrets. Never
# committed, never packaged. See tLib/shared/imports/secrets/server.lua.
config.local.lua
config/config.local.lua

# Captures: hero images, gallery stills, screen recordings. Large, regenerable
# and no business in the history. The hand-supplied hero backdrop is the
# exception — a gameplay screenshot the repo cannot reproduce.
#
# ⚠️ A DIRECTORY-FORM IGNORE CANNOT BE NEGATED FROM INSIDE. `/assets/` makes git
# skip the tree without reading it, so no `!` rule below it ever matches. Hence
# `/assets/*`, which leaves `assets/` listable.
/assets/*
!/assets/hero/

# The Cfx/Tebex listing copy, and nothing else under assets/. It is not a
# capture, it is the product claim: every warranty, compatibility statement and
# non-affiliation line a buyer reads lives in these two files, and until
# 2026-10-23 they were untracked in five of seven resources — a copy change with
# no history, no review and no way back.
!/assets/cfx/
/assets/cfx/*
!/assets/cfx/*.txt
